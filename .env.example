# MinIO / S3 Storage
MINIO_PUBLIC_URL=https://public-storage.example.com
MINIO_PUBLIC_ROOT_USER=minioadmin
MINIO_PUBLIC_ROOT_PASSWORD=miniopassword
MINIO_MAX_CHUNK_SIZE_MB=50
MINIO_BUCKET_NAME=knowledge-base
MINIO_REGION=us-east-1

# PostgreSQL with pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# OpenWebUI / LLM & Vector Embeddings
OPENWEBUI_URL=http://localhost:3000/
OPENWEBUI_API_KEY=your_openwebui_api_key_here
OPENWEBUI_MODEL=gemma4:latest
OPENWEBUI_EMBEDDING_MODEL=embeddinggemma:latest
MAX_EMBED_TOKENS=8000
EMBEDDING_DIM=768

# Authentication & Google OAuth
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# AWS SES (Email Notifications & Invitations)
AWS_SES_ACCESS_KEY_ID=your_aws_ses_access_key
AWS_SES_SECRET_ACCESS_KEY=your_aws_ses_secret_key
AWS_SES_REGION=ap-northeast-2
SES_FROM_EMAIL_NOTIFY=notify@example.com
